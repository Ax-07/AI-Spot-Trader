AI_SPOT_TRADER_ENVIRONMENT=development
AI_SPOT_TRADER_API_HOST=127.0.0.1
AI_SPOT_TRADER_API_PORT=8000
AI_SPOT_TRADER_LOG_LEVEL=INFO
AI_SPOT_TRADER_EXECUTION_MODE=PAPER
AI_SPOT_TRADER_LLM_MODEL=gpt-5.6-luna
# Set AI_SPOT_TRADER_AGGRESSIVENESS to an integer from 1 to 10 when a run needs it.

# Batch 07 LLM provider. Keep the real key only in the local environment/.env.
AI_SPOT_TRADER_OPENAI_API_KEY=
AI_SPOT_TRADER_OPENAI_BASE_URL=https://api.openai.com/v1
AI_SPOT_TRADER_OPENAI_TIMEOUT_SECONDS=30

# Public Kraken Spot market-data endpoints; no API key is required.
AI_SPOT_TRADER_KRAKEN_REST_URL=https://api.kraken.com
AI_SPOT_TRADER_KRAKEN_WS_URL=wss://ws.kraken.com/v2
AI_SPOT_TRADER_KRAKEN_REST_TIMEOUT_SECONDS=10
AI_SPOT_TRADER_KRAKEN_WS_RECEIVE_TIMEOUT_SECONDS=15
AI_SPOT_TRADER_KRAKEN_WS_MAX_RECONNECT_ATTEMPTS=2
AI_SPOT_TRADER_KRAKEN_WS_RECONNECT_DELAY_SECONDS=1
# Optional technical freshness guard. Leave unset until a caller explicitly selects a threshold.
# AI_SPOT_TRADER_KRAKEN_STALE_AFTER_SECONDS=30

# Batch 09 durable audit database. Keep credentials in the local .env only.
# AI_SPOT_TRADER_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_spot_trader
