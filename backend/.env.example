AI_SPOT_TRADER_ENVIRONMENT=development
AI_SPOT_TRADER_API_HOST=127.0.0.1
AI_SPOT_TRADER_API_PORT=8000
AI_SPOT_TRADER_LOG_LEVEL=INFO
AI_SPOT_TRADER_EXECUTION_MODE=PAPER
AI_SPOT_TRADER_LLM_MODEL=gpt-5.6-luna

# PAPER runtime. paper_symbol + paper_market_type remain the backwards-compatible bootstrap
# market and must belong to PAPER_EXECUTABLE_MARKETS when that universe is configured.
# AI_SPOT_TRADER_PAPER_SYMBOL=<BASE/QUOTE>
# AI_SPOT_TRADER_PAPER_MARKET_TYPE=<SPOT-or-PERPETUAL>
# Batch 18.2 typed execution universe. Pydantic Settings expects a JSON array.
# Every entry is MARKET_TYPE:BASE/QUOTE. FUTURE is discoverable but not executable.
# Omit this field to preserve the historical singleton bootstrap market.
# AI_SPOT_TRADER_PAPER_EXECUTABLE_MARKETS=["SPOT:BTC/USD","SPOT:ETH/USD","PERPETUAL:SOL/USD"]
# AI_SPOT_TRADER_PAPER_INITIAL_CAPITAL=<positive-decimal>
# All executable markets must use this same quote/settlement asset in Batch 18.2.
# AI_SPOT_TRADER_PAPER_SETTLEMENT_ASSET=<QUOTE>
# AI_SPOT_TRADER_TRADING_CADENCE_SECONDS=<positive-seconds>
# AI_SPOT_TRADER_AGGRESSIVENESS=<1-10>
# AI_SPOT_TRADER_CYCLE_MARKET_TIMEOUT_SECONDS=<positive-seconds>
# AI_SPOT_TRADER_CYCLE_AGENT_TIMEOUT_SECONDS=<positive-seconds>
# AI_SPOT_TRADER_CYCLE_BROKER_TIMEOUT_SECONDS=<positive-seconds>
# Technical mark-to-market loops. They do not call the LLM.
AI_SPOT_TRADER_PAPER_MARK_TO_MARKET_CADENCE_SECONDS=5
AI_SPOT_TRADER_PAPER_DERIVATIVE_MARK_TO_MARKET_CADENCE_SECONDS=15
AI_SPOT_TRADER_PAPER_MARK_TO_MARKET_TIMEOUT_SECONDS=5
AI_SPOT_TRADER_PAPER_MARK_TO_MARKET_STALE_AFTER_SECONDS=30
# AI_SPOT_TRADER_RISK_MAX_ORDER_NOTIONAL=<positive-decimal>
# Symbol whitelist remains a deterministic Risk boundary. It must contain every symbol in
# PAPER_EXECUTABLE_MARKETS; the typed universe additionally distinguishes SPOT/PERPETUAL.
# AI_SPOT_TRADER_RISK_ALLOWED_PAIRS=["BTC/USD","ETH/USD","SOL/USD"]
# AI_SPOT_TRADER_RISK_ALLOW_QUANTITY_REDUCTION=<true-or-false>
# AI_SPOT_TRADER_PAPER_FEE_RATE=<decimal-fraction>
# AI_SPOT_TRADER_PAPER_SPREAD_BPS=<non-negative-bps>
# AI_SPOT_TRADER_PAPER_SLIPPAGE_BPS=<non-negative-bps>

# Kraken Derivatives PAPER safety settings. Required when any executable market is PERPETUAL.
# Leverage stays deterministic configuration owned by Risk, never the LLM.
# AI_SPOT_TRADER_PAPER_DERIVATIVE_LEVERAGE=1
AI_SPOT_TRADER_PAPER_DERIVATIVE_MARGIN_MODE=ISOLATED
AI_SPOT_TRADER_RISK_MAX_DERIVATIVE_LEVERAGE=1
# AI_SPOT_TRADER_RISK_MAX_DERIVATIVE_POSITION_NOTIONAL=<positive-decimal>
# AI_SPOT_TRADER_RISK_MAX_TOTAL_DERIVATIVE_EXPOSURE=<positive-decimal>
AI_SPOT_TRADER_RISK_DERIVATIVE_LIQUIDATION_BUFFER_RATIO=1.10

# OpenAI provider. Keep the real key only in the local environment/.env.
AI_SPOT_TRADER_OPENAI_API_KEY=
AI_SPOT_TRADER_OPENAI_BASE_URL=https://api.openai.com/v1
AI_SPOT_TRADER_OPENAI_TIMEOUT_SECONDS=30
# Bounded read-only research budget used in the market-selection phase.
AI_SPOT_TRADER_AGENT_TOOL_MAX_CALLS=6
AI_SPOT_TRADER_AGENT_TOOL_TIMEOUT_SECONDS=5
AI_SPOT_TRADER_AGENT_TOOL_MAX_RESULT_BYTES=32768
AI_SPOT_TRADER_AGENT_TOOL_LIST_MARKETS_MAX_LIMIT=50

# Public Kraken Spot market-data endpoints; no API key is required or accepted.
AI_SPOT_TRADER_KRAKEN_REST_URL=https://api.kraken.com
AI_SPOT_TRADER_KRAKEN_WS_URL=wss://ws.kraken.com/v2
# Public Kraken Derivatives REST endpoint; no private order route is implemented.
AI_SPOT_TRADER_KRAKEN_DERIVATIVES_REST_URL=https://futures.kraken.com/derivatives/api/v3
AI_SPOT_TRADER_KRAKEN_REST_TIMEOUT_SECONDS=10
AI_SPOT_TRADER_KRAKEN_WS_RECEIVE_TIMEOUT_SECONDS=15
AI_SPOT_TRADER_KRAKEN_WS_MAX_RECONNECT_ATTEMPTS=2
AI_SPOT_TRADER_KRAKEN_WS_RECONNECT_DELAY_SECONDS=1
# AI_SPOT_TRADER_KRAKEN_STALE_AFTER_SECONDS=<positive-seconds>

# PostgreSQL is mandatory for the executable PAPER composition.
# AI_SPOT_TRADER_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_spot_trader
